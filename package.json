{
  "name": "cleverplayer",
  "version": "4.0.11",
  "description": "CLEVER Console & Video Wall Player",
  "main": "index.js",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "win32": "electron-builder --win --ia32",
    "win64": "electron-builder --win --x64",
    "ubuntu32": "electron-builder --linux --ia32",
    "ubuntu64": "electron-builder --linux --x64"
  },
  "homepage": "www.closed-loop.biz",
  "author": {
    "name": "Closed-Loop Technology Pte. Ltd",
    "email": "sales@closed-loop.biz"
  },
  "dependencies": {
    "@electron/remote": "^2.1.1",
    "@napi-rs/canvas": "^0.1.53",
    "@wuild/electron-notification": "^1.0.3",
    "body-parser": "^1.20.2",
    "browser-window": "^0.4.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "date-and-time": "^3.1.0",
    "electron-log": "^3.0.6",
    "electron-shutdown-command": "^2.0.1",
    "express": "^4.18.2",
    "express-csp-header": "^5.2.1",
    "ip": "^1.1.5",
    "is-port-reachable": "^4.0.0",
    "is-reachable": "^5.2.1",
    "log-timestamp": "^0.3.0",
    "macaddress": "^0.5.2",
    "node-cmd": "^3.0.0",
    "node-notifier": "^6.0.0",
    "qrcode": "^1.5.0",
    "remote": "^0.2.6",
    "systeminformation": "^5.21.22",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "electron": "^28.1.2",
    "electron-builder": "^22.3.2",
    "electron-builder-squirrel-windows": "^22.3.3"
  },
  "build": {
    "appId": "com.clt.cleverplayer",
    "productName": "CLEVER - Player For Console & Video Wall",
    "extraResources": [
      {
        "from": "./cert",
        "to": "cert"
      }
    ],
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "build/release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon/clt.png"
    },
    "linux": {
      "target": "deb",
      "icon": "build/icon/clt.png",
      "category": "AudioVideo",
      "desktop": "cleverplayer"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": "default",
      "icon": "build/icon/clt.icns"
    }
  }
}
