{
  "name": "cltcleverapp",
  "version": "4.0.1",
  "description": "Clever v3 Player",
  "main": "index.js",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "pack": "build --dir",
    "dist": "electron-builder --linux"
  },
  "homepage": "www.closed-loop.biz",
  "author": {
    "name": "Closed-Loop Technology Pte. Ltd",
    "email": "sales@closed-loop.biz"
  },
  "dependencies": {
    "@electron/remote": "^2.0.9",
    "@wuild/electron-notification": "^1.0.3",
    "app": "^0.1.0",
    "browser-window": "^0.4.0",
    "crypto": "^1.0.1",
    "date-and-time": "^0.8.1",
    "electron-log": "^3.0.6",
    "ip": "^1.1.5",
    "is-reachable": "^4.0.0",
    "macaddress": "^0.5.2",
    "node-cmd": "^3.0.0",
    "node-notifier": "^6.0.0",
    "qrcode": "^1.5.0",
    "remote": "^0.2.6",
    "systeminformation": "^5.16.9",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^22.3.2",
    "electron-builder-squirrel-windows": "^22.3.3"
  },
  "build": {
    "appId": "com.electron.closedloop.cltcleverapp",
    "productName": "CLT - Clever",
    "directories": {
      "output": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "./build/clt.png",
      "legalTrademarks": "Copyright by Closed-loop Technology Pte Ltd. All rights reserved"
    },
    "linux": {
      "target": "deb",
      "icon": "./build/clt.png",
      "category": "AudioVideo",
      "desktop": "cleverapp"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": "default",
      "icon": "./build/clt.icns"
    }
  }
}
